<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>OidcStarter.AspNetCore.Bff</PackageId>
    <Title>OIDC Starter ASP.NET Core BFF</Title>
    <Authors>Morda Labs</Authors>
    <Company>Morda Labs</Company>
    <Version>1.0.1</Version>
    <Description>Reusable ASP.NET Core backend-for-frontend authentication building blocks for cookie-backed OIDC sign-in, logout, and current-user endpoints.</Description>
    <PackageTags>aspnetcore;oidc;bff;authentication;openidconnect</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/MordaLabs/oidc-starter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MordaLabs/oidc-starter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" Version="9.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="9.0.4" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="9.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="RELEASE_NOTES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
