<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>OidcStarter.AspNetCore.Bff</PackageId>
    <Authors>OIDC Starter</Authors>
    <Description>Reusable ASP.NET Core BFF authentication building blocks for the OIDC Starter sample.</Description>
    <PackageTags>aspnetcore;oidc;bff;authentication</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.4" />
  </ItemGroup>

</Project>
